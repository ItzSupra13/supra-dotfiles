{
	"layer": "top",
	"exclusive": true,
	"reload_style_on_change": true,
	"position": "right",
	"margin-top": 0,
	"margin-left": 0,
	"margin-right": 0,
	"margin-bottom": 0,
	"spacing": 0,
	"height": 0,
	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],
	// -----------------------------------------------------
	// Module Layout
	// -----------------------------------------------------
	"modules-left": [
		"custom/power",
		"custom/separator",
		"hyprland/workspaces",
		"custom/separator",
		"mpris"
	],
	"modules-center": [
		"wlr/taskbar"
	],
	"modules-right": [
		"pulseaudio",
		"bluetooth",
		"network",
		"custom/update",
		"battery",
		"clock#t",
		"clock#d"
	],
	// -----------------------------------------------------
	// Center Modules (Tabs & Workspaces)
	// -----------------------------------------------------
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 18,
		"spacing": 5,
		"on-click-middle": "close",
		"tooltip-format": "{title}",
		"on-click": "activate",
		"ignore-list": [
			"Alacritty"
		]
	},
	// -----------------------------------------------------
	// Right Modules (Hardware & System)
	// -----------------------------------------------------
	"battery": {
		"justify": "center",
		"interval": 5,
		"states": {
			"warning": 20,
			"critical": 10
		},
		"format": "{icon}",
		"format-icons": [
			"<span size='12pt'>󰁺</span>",
			"<span size='12pt'>󰁻</span>",
			"<span size='12pt'>󰁼</span>",
			"<span size='12pt'>󰁽</span>",
			"<span size='12pt'>󰁾</span>",
			"<span size='12pt'>󰁿</span>",
			"<span size='12pt'>󰂀</span>",
			"<span size='12pt'>󰂁</span>",
			"<span size='12pt'>󰂂</span>",
			"<span size='12pt'>󰁹</span>"
		],
		"format-charging": "<span size='12pt'>󰂄</span>",
		"format-plugged": "<span size='12pt'>󰚥</span>",
		"format-full": "{capacity}%\nbat_f",
		"format-critical": "<span size='12pt'>󰂃</span>",
		"tooltip": true,
		"tooltip-format": "Charge: {capacity}%\n{timeTo}",
		"tooltip-format-charging": "Charging: {capacity}%\n{timeTo}",
		//"on-click": "omarchy-menu power",
		//"on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
	},
	"clock#t": {
		"justify": "center",
		"format": "<span weight='500'>{:%H\n%M}</span>",
		"format-alt": "<span weight='500'>{:\n%H\n%M}</span>",
		// "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
	},
	"clock#d": {
		"justify": "center",
		"format": "<span weight='700'>{:%d/%m}</span>",
		"format-alt": "<span weight='700'>{:%d/%m}</span>",
		"tooltip-format": "<span>{calendar}</span>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-click-right": "mode",
			"format": {
				"month": "<span color='#ffead3'><b>{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b>{}</b></span>",
			}
		}
	}
}